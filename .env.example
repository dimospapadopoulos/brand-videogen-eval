# Copy to .env and fill in. .env is gitignored and never committed.

# Required only for the real judge pass (`vgeval judge`). The mock run and
# canary work without it.
ANTHROPIC_API_KEY=

# Judge model (vision-capable). Opus 4.8 for max fidelity on defect scoring.
VGEVAL_JUDGE_MODEL=claude-opus-4-8

# Async worker concurrency for the runner (sized for hundreds/batch).
VGEVAL_CONCURRENCY=8

# Number of frames sampled from each output video for the judge.
# Raise for better recall of temporal defects (more image tokens = more cost).
VGEVAL_JUDGE_FRAMES=6

# Defect gate: a physical-integrity dim at/below this caps the clip's overall.
# Blank = default (scale.min + 1, i.e. <=2 on a 1..5 scale). Set 3 for a stricter
# bar (would also gate a "3" like veo's), 0 to disable gating.
VGEVAL_GATE_THRESHOLD=
